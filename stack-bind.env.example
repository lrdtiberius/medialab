# Nur fuer die alternative Bind-Mount-Stackdatei.
VIDEOS_HOST_PATH=/mnt/Videos
WEB_PORT=8099
PUID=1026
PGID=100
TZ=Europe/Berlin

# TMDB-Zugangsdaten liegen im gemounteten Video-Ordner:
#   _config/tmdb.env   (empfohlen)
#   _config/tmdb.txt
TMDB_CREDENTIALS_FILE=

DRY_RUN=true
AUTO_PROCESS=true
WEB_USERNAME=
WEB_PASSWORD=

LIBRARY_CACHE_SECONDS=600
LIBRARY_PAGE_SIZE=60

# Echte Aufloesungs-, Video-, Audio- und Untertitelspur-Erkennung
FFPROBE_ENABLED=true
FFPROBE_TIMEOUT_SECONDS=90
# Anzahl paralleler ffprobe-Lesevorgaenge beim Komplettscan (NAS-schonend: 1-2).
LIBRARY_PROBE_CONCURRENCY=2
# true startet die Bestandsanalyse bei jedem Containerstart; empfohlen bleibt false.
LIBRARY_PROBE_AUTO_START=false
