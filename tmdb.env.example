# Datei umbenennen in tmdb.env und in Synology File Station hier ablegen:
# video/_config/tmdb.env
#
# Aus Sicht des Containers: /media/_config/tmdb.env
# Mindestens EIN Wert muss gesetzt sein. Der Read Access Token wird bevorzugt.
# Keine Anfuehrungszeichen und kein vorangestelltes "Bearer " verwenden.
TMDB_READ_TOKEN=HIER_DEIN_API_READ_ACCESS_TOKEN
TMDB_API_KEY=HIER_DEIN_V3_API_KEY
